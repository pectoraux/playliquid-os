// Playliquid OS — Frozen Primitives Schema
// 10 permanent contracts: Package, Specification, Contract, Entity,
// WorldProject, WorldBuild, Kernel, RuntimeAdapter, WorldNode, WorldService.
//
// NOTE on provider: models use only portable scalar types (String, Int, Float,
// Boolean, DateTime) so the schema is identical across SQLite (local/sandbox)
// and PostgreSQL (Neon/Vercel production). To deploy to Neon, change
// `provider = "sqlite"` → `provider = "postgresql"` and set DATABASE_URL +
// DIRECT_URL to the Neon connection strings. No model edits are required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #1 — PACKAGE
// Everything that exists in a World is a Package.
// ════════════════════════════════════════════════════════════════
model Package {
  id            String   @id @default(cuid())
  name          String   @unique // scoped e.g. "@playliquid/buildings/amsterdam-canal-house"
  displayName   String
  description   String
  family        String   // avatar | building | road | vehicle | physics | weather | renderer | sensory | ...
  version       String   // semver
  hash          String   @unique // content hash of manifest+specification+artifact
  manifest      String   // JSON: full manifest
  specification String   // JSON: canonical Specification IR
  artifactUri   String?  // where the generated artifact lives
  provenance    String   // JSON: { generator, llmProvider, model, generatedAt, source }
  certification String   // JSON: { signed, level, by, checks[] }
  license       String   // SPDX identifier e.g. "MIT"
  capabilities  String   // JSON array of capability strings
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  specRefId String?
  specRef   Specification? @relation(fields: [specRefId], references: [id])

  provides       Interface[] @relation("PackageProvides")
  requires       Interface[] @relation("PackageRequires")
  buildPackages  WorldBuildPackage[]
  entities       Entity[]
  generationReq  GenerationRequest?
  contributions  Contribution[]
  runtimeArtifacts RuntimeArtifact[]
  versions       PackageVersion[]
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #3 — INTERFACE / CONTRACT
// Capability families. Packages provide / require them. The Composer wires.
// ════════════════════════════════════════════════════════════════
model Interface {
  id            String  @id @default(cuid())
  name          String  // e.g. "spatial.anchor", "avatar.movement"
  family        String  // e.g. "spatial", "avatar", "physics", "sensory"
  version       String  // semver of THIS contract instance
  minCompatible String  @default("0.0.0") // minimum version this interface is compatible with
  direction     String  // "provides" | "requires"
  schema        String  // JSON schema describing the contract
  description   String

  packageProvidedById String?
  packageProvidedBy   Package? @relation("PackageProvides", fields: [packageProvidedById], references: [id], onDelete: Cascade)

  packageRequiredById String?
  packageRequiredBy   Package? @relation("PackageRequires", fields: [packageRequiredById], references: [id], onDelete: Cascade)

  @@index([name, version])
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #2 — SPECIFICATION
// The canonical truth. Distinct from NL, prompt, and artifact.
// ════════════════════════════════════════════════════════════════
model Specification {
  id              String   @id @default(cuid())
  naturalLanguage String?  // original user input (kept for provenance)
  canonical       String   // JSON canonical IR
  kind            String   // "package" | "world" | "entity"
  theme           String?  // JSON world-theme reference
  spatialRules    String?  // JSON
  policies        String?  // JSON
  createdAt       DateTime @default(now())

  packages      Package[]
  worldProjects WorldProject[]
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #4 — WORLD PROJECT
// Git-like collaborative source repository for a World.
// ════════════════════════════════════════════════════════════════
model WorldProject {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  theme           String   // JSON: { era, artDirection, scale, coordinateSystem, ... }
  rules           String   // JSON: world rules
  packageManifest String   // JSON: declared package refs
  contributors    String   // JSON array
  specificationId String?
  specification   Specification? @relation(fields: [specificationId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  builds WorldBuild[]
  serviceBindings WorldServiceBinding[]
  capabilityPolicies CapabilityPolicy[]
  spatialSlots SpatialSlot[]
  contributions Contribution[]
  branches WorldBranch[]
  commits WorldCommit[]
  pullRequests PullRequest[]
  spatialAnchors SpatialAnchor[]
  sensoryChannels SensoryChannel[]
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #6 — WORLD BUILD
// Immutable, reproducible artifact of a composed World.
// ════════════════════════════════════════════════════════════════
model WorldBuild {
  id             String   @id @default(cuid())
  version        Int      // build number for the project
  worldProjectId String
  worldProject   WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  manifest       String   // immutable JSON: package versions, resolved deps, interface connections, spatial graph, capability policies, runtime config
  manifestLock   String   @default("{}") // JSON: content-addressed lock — exact package hashes + interface versions, the sole immutable executable artifact
  hash           String   @unique
  branchName     String   @default("main") // which branch this build was composed from
  commitHash     String?  // the head commit this build was composed from
  status         String   // "draft" | "composed" | "ready"
  createdAt      DateTime @default(now())

  packages WorldBuildPackage[]
  nodes    WorldNode[]
  entities Entity[]
}

model WorldBuildPackage {
  id           String      @id @default(cuid())
  worldBuildId String
  worldBuild   WorldBuild  @relation(fields: [worldBuildId], references: [id], onDelete: Cascade)
  packageId    String
  package      Package     @relation(fields: [packageId], references: [id])
  resolvedAt   DateTime    @default(now())

  @@unique([worldBuildId, packageId])
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #5 — ENTITY
// A Package instantiated into a running World.
// ════════════════════════════════════════════════════════════════
model Entity {
  id           String   @id @default(cuid())
  worldBuildId String
  worldBuild   WorldBuild @relation(fields: [worldBuildId], references: [id], onDelete: Cascade)
  packageId    String
  package      Package  @relation(fields: [packageId], references: [id])
  name         String
  position     String   // JSON { x, y, z }
  components   String   // JSON array
  state        String   // JSON
  createdAt    DateTime @default(now())

  events KernelEvent[]
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #9 — WORLD NODE
// A deployable runtime instance of a Build. Host = impl detail.
// ════════════════════════════════════════════════════════════════
model WorldNode {
  id           String      @id @default(cuid())
  worldBuildId String
  worldBuild   WorldBuild  @relation(fields: [worldBuildId], references: [id], onDelete: Cascade)
  host         String      // "vercel" | "aws" | "local" | "edge"
  endpoint     String      // standardized discovery endpoint
  status       String      // "starting" | "running" | "stopped" | "error"
  health       String      // JSON metrics
  capabilities String      // JSON
  startedAt    DateTime?
  createdAt    DateTime    @default(now())
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #7 — KERNEL
// Event bus + scheduler traces. The Kernel itself is the runtime;
// these rows are the observable record of its operation.
// ════════════════════════════════════════════════════════════════
model KernelEvent {
  id        String   @id @default(cuid())
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type      String   // "scheduler.tick" | "entity.spawn" | "capability.invoke" | "state.mutate" | ...
  payload   String   // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

// ════════════════════════════════════════════════════════════════
// PIPELINE — GENERATION REQUEST
// Traces the NL → Specification → Prompt → LLM → Package pipeline.
// ════════════════════════════════════════════════════════════════
model GenerationRequest {
  id            String   @id @default(cuid())
  input         String   // natural language
  specification String   // JSON canonical IR produced
  prompt        String   // compiled prompt
  provider      String   // "zai" | "claude" | "gemini" | "local" | ...
  status        String   // "specifying" | "resolving" | "prompting" | "generating" | "done" | "error"
  packageId     String?  @unique
  package       Package? @relation(fields: [packageId], references: [id])
  log           String   // JSON pipeline trace
  createdAt     DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════
// AUTHENTICATION — Users, Waitlist, NextAuth tables
// ════════════════════════════════════════════════════════════════
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         String    @default("USER") // ADMIN | USER | DEMO
  status       String    @default("ACTIVE") // ACTIVE | WAITLIST | DISABLED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  note      String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  userId    String?  // the User created when approved
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ════════════════════════════════════════════════════════════════
// PRIMITIVE #10 — WORLD SERVICE
// Platform-provided OS services: Multiplayer, Streaming, Persistence,
// Voice, Ads, Analytics, Moderation, Economy, Identity, Storage...
// These are NOT implemented by the user's LLM. The OS provides them;
// packages consume them through Contracts.
// ════════════════════════════════════════════════════════════════
model WorldService {
  id                  String   @id @default(cuid())
  name                String   @unique // e.g. "playliquid.multiplayer", "playliquid.streaming"
  displayName         String
  description         String
  category            String   // "networking" | "persistence" | "streaming" | "voice" | "ads" | "identity" | "analytics" | "moderation" | "economy" | "storage"
  contract            String   // JSON: the contract this service fulfills
  provider            String   // "playliquid" | "vercel" | "cloudflare" | "custom"
  status              String   @default("ACTIVE") // ACTIVE | DRAFT | DEPRECATED
  // ── item 7: honest status — contract vs implementation ──
  implementationStatus String  @default("contract-only") // contract-only | simulator | partial | production
  implementationNote  String   @default("") // human-readable note on what the implementation actually does
  config              String   // JSON: service configuration
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // which world projects have enabled this service
  enabledIn WorldServiceBinding[]
}

model WorldServiceBinding {
  id              String      @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  worldServiceId  String
  worldService    WorldService @relation(fields: [worldServiceId], references: [id])
  enabled         Boolean     @default(true)
  config          String      // JSON: world-specific override
  createdAt       DateTime    @default(now())

  @@unique([worldProjectId, worldServiceId])
}

// ════════════════════════════════════════════════════════════════
// MULTI-LAYER CAPABILITY POLICY (the Superman example)
//
//   Entity capabilities (from Package)
//     × World policy
//     × Zone policy
//     × Experience policy
//     = Effective capabilities (computed by the Kernel)
//
// The package stays reusable across 500 worlds. The world does NOT
// modify the package — it layers policies on top.
// ════════════════════════════════════════════════════════════════
model CapabilityPolicy {
  id              String   @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  layer           String   // "world" | "zone" | "experience"
  zoneName        String?  // for zone-layer policies
  experienceName  String?  // for experience-layer policies
  capability      String   // e.g. "flight", "super_strength", "avatar.movement"
  rules           String   // JSON: [{ packageFamily, package, action: "allow"|"deny"|"limit", params }]
  priority        Int      @default(0) // higher = evaluated later, can override
  createdAt       DateTime @default(now())

  @@index([worldProjectId, layer])
  @@index([capability])
}

// ════════════════════════════════════════════════════════════════
// SPATIAL SLOTS — the spatial attachment API
//
// A World Project defines named spatial slots (canal-network,
// city-center, museum-district...). Packages declare which slot they
// require. The Composer attaches packages to matching slots.
// ════════════════════════════════════════════════════════════════
model SpatialSlot {
  id              String   @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  name            String   // e.g. "canal-network", "city-center"
  displayName     String
  slotType        String   // "region" | "network" | "district" | "plot" | "anchor"
  bounds          String   // JSON: { x, y, z, w, h, d }
  acceptedFamilies String  // JSON array of package families this slot accepts
  capacity        Int?     // max packages that can attach (null = unlimited)
  // ── Formal spatial contract fields (item 5) ──
  coordinateSystem String  @default("cartesian-meters") // how bounds are interpreted
  scale           String   @default("medium") // "small" | "medium" | "large" | "planetary"
  adjacency       String   @default("[]") // JSON: names of slots this slot is adjacent to
  containment     String   @default("[]") // JSON: names of slots this slot contains (parent → children)
  attachmentPoints String  @default("[]") // JSON: named attachment points [{ name, position, direction }]
  topology        String   @default("mesh") // "mesh" | "linear" | "tree" | "graph"
  // ── Connection to SpatialAnchor (item 14) ──
  // A slot resolves to a specific spatial anchor at composition time.
  // This connects the composition-time slot to the runtime-time anchor,
  // so a contributor targeting a slot gets placed at the right anchor.
  anchorSemanticId String? // the semantic ID of the SpatialAnchor this slot resolves to
  createdAt       DateTime @default(now())

  @@unique([worldProjectId, name])
}

// ════════════════════════════════════════════════════════════════
// CONTRIBUTIONS — World Projects as GitHub for Worlds
//
// Contributors propose Packages to a World Project. Maintainers
// review and merge (bind) or reject them. A contribution carries a
// specification + a target spatial slot + a capability declaration.
// ════════════════════════════════════════════════════════════════
model Contribution {
  id              String   @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  packageId       String?
  package         Package?  @relation(fields: [packageId], references: [id])
  contributorName String
  title           String
  description     String
  targetSlot      String?  // the spatial slot this contribution attaches to
  status          String   @default("PENDING") // PENDING | MERGED | REJECTED | DRAFT
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([worldProjectId, status])
}

// ════════════════════════════════════════════════════════════════
// WORLD PROJECT BRANCHES & COMMITS — Git-like version control
// (item 8: Turn World Projects into genuinely Git-like repositories)
// ════════════════════════════════════════════════════════════════
model WorldBranch {
  id              String   @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  name            String   // "main" | "paris-reconstruction" | "contributor/alice"
  parentBranchId  String?  // the branch this was forked from
  headCommitId    String?  // the latest commit on this branch
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  commits   WorldCommit[]
  pullReqs  PullRequest[] @relation("PRSourceBranch")
  targetPRs PullRequest[] @relation("PRTargetBranch")

  @@unique([worldProjectId, name])
}

model WorldCommit {
  id              String   @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  branchId        String
  branch          WorldBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentCommitId  String?  // previous commit (forms the history graph)
  hash            String   @unique // content hash of the commit
  authorName      String
  message         String
  // the commit payload: the package manifest state at this commit
  packageManifest String   // JSON array of package names
  spatialSlots    String   // JSON: snapshot of spatial slots at this commit
  policies        String   // JSON: capability policies at this commit
  createdAt       DateTime @default(now())

  @@index([branchId, createdAt])
}

model PullRequest {
  id                  String   @id @default(cuid())
  worldProjectId      String
  worldProject        WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  title               String
  description         String
  sourceBranchId      String
  sourceBranch        WorldBranch @relation("PRSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Cascade)
  targetBranchId      String
  targetBranch        WorldBranch @relation("PRTargetBranch", fields: [targetBranchId], references: [id], onDelete: Cascade)
  status              String   @default("OPEN") // OPEN | MERGED | CLOSED | DRAFT
  contributorName     String
  reviewStatus        String   @default("PENDING") // PENDING | APPROVED | CHANGES_REQUESTED | REJECTED
  reviewerName        String?
  reviewedAt          DateTime?
  mergedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════
// PLAYLIQUID PROTOCOL — SPATIAL ANCHORS
// The cross-engine spatial anchoring protocol. A spatial anchor has a
// global coordinate, local coordinate, orientation, scale, semantic
// identity, parent anchor, and coordinate system. This is what makes a
// world coherent across browser, mobile, Unity, Unreal — the engine
// transforms PlayLiquid coordinates to its own; it does not own them.
// ════════════════════════════════════════════════════════════════
model SpatialAnchor {
  id              String   @id @default(cuid())
  worldProjectId  String
  worldProject    WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  // Semantic identity: e.g. "earth.netherlands.amsterdam.canal-belt"
  semanticId      String   @unique
  displayName     String
  parentAnchorId  String?  // parent anchor (forms the hierarchy)
  // Global coordinate in the PlayLiquid world coordinate system
  globalX         Float
  globalY         Float
  globalZ         Float
  // Local coordinate relative to parent
  localX          Float    @default(0)
  localY          Float    @default(0)
  localZ          Float    @default(0)
  // Orientation as quaternion (w, x, y, z)
  orientW         Float    @default(1)
  orientX         Float    @default(0)
  orientY         Float    @default(0)
  orientZ         Float    @default(0)
  scale           Float    @default(1)
  coordinateSystem String  @default("playliquid-world")
  anchorType      String   @default("point") // point | region | network | building | plot
  semantic        String   @default("") // city | district | building | road | water | etc.
  createdAt       DateTime @default(now())

  @@index([worldProjectId])
  @@index([parentAnchorId])
}

// ════════════════════════════════════════════════════════════════
// RUNTIME ARTIFACTS
// A Package has a canonical specification (engine-independent). A Runtime
// Artifact is an engine-specific implementation of that package. The
// package remains the universal primitive; the artifact is one way of
// realizing it.
//
//   Package (canonical)
//     ├── specification
//     ├── contracts
//     ├── capabilities
//     └── runtimeArtifacts
//           ├── PlayLiquid Web (canvas/WebGPU)
//           ├── Unity (scene/prefab)
//           ├── Unreal (asset)
//           └── future engines
// ════════════════════════════════════════════════════════════════
model RuntimeArtifact {
  id          String   @id @default(cuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  target      String   // "playliquid-web" | "playliquid-mobile" | "unity" | "unreal" | "godot"
  artifactUri String   // where the engine-specific artifact lives
  format      String   // "canvas-json" | "unity-prefab" | "unreal-asset" | "godot-scene"
  status      String   @default("READY") // READY | DRAFT | DEPRECATED
  metadata    String   @default("{}") // JSON: engine-specific metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([packageId, target])
}

// ════════════════════════════════════════════════════════════════
// DURABLE WORLD STATE — Event Sourcing + Snapshots (Phase G.1)
//
// Implements the `kernel.persistence` contract as a real adapter.
// The World Node does NOT own its filesystem for state durability —
// it appends events and writes snapshots through the control plane,
// which stores them here. A World Node can be killed (-9), its local
// /tmp destroyed, and a fresh node on a clean machine recovers the
// exact world state from this store.
//
//   WorldEvent    = append-only, ordered by (buildId, seq) — the
//                   authoritative history of every state mutation.
//   WorldSnapshot = full-state checkpoint; recovery loads the latest
//                   snapshot then replays WorldEvents with seq >
//                   snapshot.seq.
//
// These tables are the durable substrate. The PersistenceService
// interface (in the World Node) is the OS contract that hides whether
// the backend is this DB, Postgres, S3, Redis, or object storage.
// ════════════════════════════════════════════════════════════════
model WorldEvent {
  id        String   @id @default(cuid())
  buildId   String
  seq       Int      // monotonic per-build sequence number assigned by the World Node
  type      String   // "spawn" | "mutate" | "remove" | "session.join" | "session.leave"
  entityId  String?
  payload   String   // JSON: { position?, positionPatch?, statePatch?, timestamp, ... }
  createdAt DateTime @default(now())

  @@unique([buildId, seq])
  @@index([buildId])
  @@index([buildId, seq])
}

model WorldSnapshot {
  id          String   @id @default(cuid())
  buildId     String
  seq         Int      // the buildSeq at which this snapshot was taken
  entityCount Int
  data        String   // JSON: { buildSeq, entities[], sessions[], timestamp }
  createdAt   DateTime @default(now())

  @@index([buildId, seq])
  @@index([buildId, createdAt])
}

// ════════════════════════════════════════════════════════════════
// WORLD SERVICES — Economy, Identity, Voice (Phase M)
//
// These implement the OS service contracts that packages consume.
// The OS provides them; packages never re-implement them.
// ════════════════════════════════════════════════════════════════

// ── ECONOMY: wallets + transactions ──
// A wallet is per-player per-world-project. Transactions are append-only
// (double-entry ledger). Atomic debit/credit via DB transactions.
model PlayerWallet {
  id            String   @id @default(cuid())
  playerId      String   // the PlayerIdentity id
  worldProjectId String
  currency      String   @default("PL") // e.g. "PL", "coins", "gems"
  balance       Int      @default(0)     // integer units (cents-like)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([playerId, worldProjectId, currency])
  @@index([worldProjectId])
}

model EconomyTransaction {
  id            String   @id @default(cuid())
  fromWalletId  String?  // null = mint (system credit)
  toWalletId    String?  // null = burn (system debit)
  amount        Int      // positive integer
  currency      String
  reason        String   // "purchase" | "reward" | "transfer" | "mint" | "burn"
  reference     String?  // package-defined reference (e.g. itemId)
  status        String   @default("confirmed") // confirmed | reverted
  createdAt     DateTime @default(now())

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([createdAt])
}

// ── IDENTITY: world-player identity (distinct from console User) ──
// A PlayerIdentity is the in-world player. A User is the console account.
// One User can have multiple PlayerIdentities (one per world).
model PlayerIdentity {
  id            String   @id @default(cuid())
  userId        String?  // the console User (nullable for anonymous worlds)
  worldProjectId String
  displayName   String
  avatarUrl     String?
  metadata      String   @default("{}") // JSON: package-defined profile
  status        String   @default("ACTIVE") // ACTIVE | BANNED | SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([worldProjectId])
}

// ── VOICE: spatial voice channels ──
// A voice channel is a spatial audio room. Players join a channel;
// the channel has a spatial attenuation model (closer = louder).
model VoiceChannel {
  id            String   @id @default(cuid())
  worldProjectId String
  name          String
  spatialModel  String   @default("distance") // "distance" | "zone" | "global"
  maxListeners  Int      @default(50)
  metadata      String   @default("{}") // JSON
  createdAt     DateTime @default(now())

  @@index([worldProjectId])
}

model VoiceChannelMember {
  id            String   @id @default(cuid())
  channelId     String
  playerId      String
  position      String   @default("{}") // JSON {x,y,z} — for spatial attenuation
  muted         Boolean  @default(false)
  speaking      Boolean  @default(false)
  joinedAt      DateTime @default(now())

  @@unique([channelId, playerId])
  @@index([channelId])
}

// ════════════════════════════════════════════════════════════════
// REGISTRY / MARKETPLACE — Package Versions (Phase N)
//
// A Package has multiple published versions. Each version is an
// immutable publication: version string, content hash, artifact URI,
// changelog, certification record. The latest version is the default;
// consumers can pin a specific version or use semver resolution.
// ════════════════════════════════════════════════════════════════
model PackageVersion {
  id            String   @id @default(cuid())
  packageId     String
  package       Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  version       String   // semver: "1.0.0", "1.1.0", "2.0.0"
  hash          String   // content-addressed hash of this version's artifact
  artifactUri   String   // where the versioned artifact lives
  changelog     String   @default("") // what changed in this version
  license       String   @default("MIT") // SPDX identifier
  certification String   @default("{}") // JSON: certification record for this version
  status        String   @default("published") // published | deprecated | yanked
  publishedBy   String   @default("anonymous")
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([packageId, version])
  @@index([packageId])
  @@index([packageId, version])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════
// SENSORY RUNTIME — Smell, Haptics, Taste, Proprioception (Phase Q)
//
// Sensory emissions are like visual draw commands, but for non-visual
// senses. A package emits a "smell of coffee" at a position; the
// sensory adapter translates it to the player's olfactory device.
// Spatial attenuation: closer = stronger, like voice.
// ════════════════════════════════════════════════════════════════
model SensoryChannel {
  id            String   @id @default(cuid())
  worldProjectId String
  worldProject  WorldProject @relation(fields: [worldProjectId], references: [id], onDelete: Cascade)
  name          String   // "smell" | "haptic" | "taste" | "proprioception"
  channelType   String   // "olfactory" | "haptic" | "gustatory" | "vestibular"
  maxRange      Float    @default(50) // spatial attenuation range
  metadata      String   @default("{}") // JSON
  createdAt     DateTime @default(now())

  emissions     SensoryEmission[]

  @@unique([worldProjectId, name])
  @@index([worldProjectId])
}

model SensoryEmission {
  id            String   @id @default(cuid())
  channelId     String
  channel       SensoryChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  entityId      String   // which entity emitted this
  intensity     Float    @default(1.0) // 0.0 to 1.0
  position      String   // JSON {x,y,z} — for spatial attenuation
  payload       String   @default("{}") // JSON: { scent: "coffee", duration: 5000 }
  expiresAt     DateTime? // when the emission fades (null = persistent)
  createdAt     DateTime @default(now())

  @@index([channelId])
  @@index([entityId])
  @@index([createdAt])
}
