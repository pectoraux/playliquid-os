# Playliquid OS — environment variables
# Copy to .env and fill in. On Vercel, set these in the project settings.

# Neon PostgreSQL (pooled for runtime, direct for migrations)
DATABASE_URL="postgresql://user:pass@ep-host-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-host.region.aws.neon.tech/db?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ── LLM Provider (item 3: provider-agnostic boundary) ─────────────
# PlayLiquid knows nothing about which LLM is active. Set LLM_PROVIDER
# to one of: zai, openai, anthropic, local. Then set the provider's
# env vars below. The provider is recorded in package provenance.
LLM_PROVIDER="zai"

# Z.ai provider (default)
ZAI_BASE_URL="https://internal-api.z.ai/v1"
ZAI_API_KEY="Z.ai"
ZAI_CHAT_ID=""
ZAI_TOKEN=""
ZAI_USER_ID=""

# OpenAI provider (set when LLM_PROVIDER=openai)
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o"

# Anthropic provider (set when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Local provider — Ollama/LM Studio/vLLM (set when LLM_PROVIDER=local)
# LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
# LOCAL_LLM_MODEL="llama3"

# Admin seed (used by: bun run db:seed:auth)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
